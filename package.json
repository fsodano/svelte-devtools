{
  "name": "svelte-devtools",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "description": "Full-stack debugging for Svelte 5 and SvelteKit",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build:types && npm run build:runtime && npm run build:vite-plugin && npm run build:client && npm run build:mcp",
    "build:runtime": "npm run build -w @fsodano/svelte-devtools-runtime",
    "build:vite-plugin": "npm run build -w @fsodano/vite-plugin-svelte-devtools",
    "build:client": "npm run build -w @fsodano/svelte-devtools-client",
    "build:types": "npm run build -w @fsodano/svelte-devtools-types",
    "test": "npm run build && vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "watch": "npm run build && npm run dev -w @fsodano/svelte-devtools-types & npm run dev -w @fsodano/svelte-devtools-runtime & npm run dev -w @fsodano/vite-plugin-svelte-devtools & npm run dev -w @fsodano/svelte-devtools-client & wait",
    "clean": "rm -rf dist/ && rm -rf packages/*/dist/",
    "release:check": "node scripts/release-check.mjs",
    "prepublishOnly": "npm run build && npm test",
    "build:mcp": "npm run build -w @fsodano/svelte-devtools-mcp"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/node": "^25.5.0",
    "happy-dom": "^20.9.0",
    "rolldown": "^1.0.0-rc.13",
    "rolldown-plugin-dts": "^0.23.2",
    "svelte": "^5.55.1",
    "svelte-check": "^4.7.5",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
