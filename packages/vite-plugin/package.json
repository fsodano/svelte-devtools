{
  "name": "@fsodano/vite-plugin-svelte-devtools",
  "version": "0.2.1",
  "type": "module",
  "description": "Svelte 5 and SvelteKit DevTools for Vite: component inspection, state replay, fetch mocks, server and SQLite traces, and MCP support",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sveltekit": {
      "types": "./dist/sveltekit.d.ts",
      "import": "./dist/sveltekit.js"
    },
    "./sqlite": {
      "types": "./dist/sqlite.d.ts",
      "import": "./dist/sqlite.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@babel/parser": "^7.26.0",
    "@babel/types": "^7.26.0",
    "@fsodano/svelte-devtools-client": "^0.2.1",
    "@fsodano/svelte-devtools-runtime": "^0.2.1",
    "@fsodano/svelte-devtools-types": "^0.2.1",
    "@vitejs/devtools-kit": "^0.4.0",
    "launch-editor": "^2.14.1",
    "magic-string": "^0.30.0",
    "sirv": "^3.0.2"
  },
  "peerDependencies": {
    "@sveltejs/kit": "^2.55.0",
    "svelte": "^5.20.0",
    "vite": "^8.0.3"
  },
  "peerDependenciesMeta": {
    "@sveltejs/kit": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@sveltejs/kit": "^2.70.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fsodano/svelte-devtools.git",
    "directory": "packages/vite-plugin"
  },
  "homepage": "https://github.com/fsodano/svelte-devtools#readme",
  "bugs": {
    "url": "https://github.com/fsodano/svelte-devtools/issues"
  },
  "keywords": [
    "svelte",
    "svelte5",
    "sveltekit",
    "vite",
    "devtools",
    "debugging",
    "mcp",
    "sqlite",
    "observability",
    "rolldown"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
